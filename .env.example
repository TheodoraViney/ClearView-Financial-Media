NEXT_PUBLIC_SANITY_PROJECT_ID=hcxqlh4h
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-01
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
DEFAULT_BRAND=clearview
NEXT_PUBLIC_SITE_ENV=development
BREVO_API_KEY=
# Origin of the archive Worker (infra/archive-worker) that serves archived article records and media, no trailing slash.
# Local: run `pnpm --filter @wb/archive-worker dev` and use http://127.0.0.1:8787
ARCHIVE_ORIGIN=http://127.0.0.1:8787
# Google Ad Manager network code (2957538 for the Publisher). Leave empty to serve no ads: the slots stay empty.
NEXT_PUBLIC_GAM_NETWORK_CODE=
# Load ads without waiting for cookie consent, until CookieYes is on the site. Never on the live domains.
NEXT_PUBLIC_ADS_SKIP_CONSENT=
# Algolia site search (src/lib/algolia.ts). The search-only key answers the header suggestions on the server; the
# write key is for scripts/algolia/index-records.tsx and the publish webhook. Neither reaches the browser.
ALGOLIA_APP_ID=
ALGOLIA_SEARCH_KEY=
ALGOLIA_WRITE_KEY=
# Secret of the Sanity webhook that calls /api/algolia/sync on publish. Any long random string, the same in both places.
ALGOLIA_WEBHOOK_SECRET=
