NEXT_PUBLIC_SANITY_PROJECT_ID=hcxqlh4h
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-01
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
DEFAULT_BRAND=clearview
NEXT_PUBLIC_SITE_ENV=development
BREVO_API_KEY=
# Origin of the archive Worker (infra/archive-worker) that serves archived article records and media, no trailing slash.
# Local: run `pnpm --filter @wb/archive-worker dev` and use http://127.0.0.1:8787
ARCHIVE_ORIGIN=http://127.0.0.1:8787
# Google Ad Manager network code (2957538 for the Publisher). Leave empty to serve no ads: the slots stay empty.
NEXT_PUBLIC_GAM_NETWORK_CODE=
# Treat cookie consent as given (ads and video embeds load), for testing where the CookieYes banner does not show:
# localhost and *.vercel.app. Never on the live domains.
NEXT_PUBLIC_SKIP_CONSENT=
# "true" loads the brand's GTM container (src/brands.ts), which sends to the client's live GA4. Production only; leave
# empty in development and staging unless testing with GTM Preview.
NEXT_PUBLIC_GTM_ENABLED=
# Service account JSON key from the Publisher's Google Cloud project (gam-readonly), on one line in single quotes. Studio
# uses it to look up the unit codes typed into Brand settings in Ad Manager, read only. Empty: codes are not checked.
GAM_SERVICE_ACCOUNT_KEY=
# Algolia site search (src/lib/algolia.ts). The search-only key answers the header suggestions on the server; the
# write key is for scripts/algolia/index-records.tsx and the publish webhook. Neither reaches the browser.
ALGOLIA_APP_ID=
ALGOLIA_SEARCH_KEY=
ALGOLIA_WRITE_KEY=
# Secret of the Sanity webhook that calls /api/algolia/sync on publish. Any long random string, the same in both places.
ALGOLIA_WEBHOOK_SECRET=
# Encrypts the token on the link Brevo sends a reader to after the signup confirmation click, so the team's signup email
# (src/lib/signup-notification.ts) goes out only for a real confirmation. Any long random string. Empty: signups still
# work, but confirmations by email send the team nothing.
SIGNUP_NOTIFY_SECRET=
# Jotform API key of the client's account, for the Sponsorship enquiry and Contact forms (src/lib/jotform.ts). The form
# ids are in src/lib/enquiry-server.ts; JOTFORM_SPONSORSHIP_FORM_ID and JOTFORM_CONTACT_FORM_ID override them (optional).
JOTFORM_API_KEY=
