{
  "name": "wealth-briefing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "certs": "bash scripts/dev-certs.sh",
    "dev:https": "NEXT_PUBLIC_DEV_HTTPS=true next dev --experimental-https --experimental-https-key ./certificates/localhost-key.pem --experimental-https-cert ./certificates/localhost.pem",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typegen": "sanity schema extract --path=./schema.json --force && sanity typegen generate",
    "typecheck": "tsc --noEmit",
    "seed:brands": "bun scripts/seed-brands.ts"
  },
  "dependencies": {
    "@sanity/client": "8.6.1",
    "@sanity/icons": "5.2.2",
    "@sanity/image-url": "2.1.1",
    "next": "16.3.4",
    "next-sanity": "13.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanity": "6.13.2",
    "sanity-plugin-media": "^6.2.0",
    "server-only": "^0.0.1",
    "styled-components": "6.5.3"
  },
  "devDependencies": {
    "@portabletext/block-tools": "^6.0.1",
    "@portabletext/schema": "^3.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "^30.1.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.32.1"
}
